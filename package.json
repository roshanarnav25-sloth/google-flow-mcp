{
  "name": "google-flow-mcp-server",
  "version": "0.1.0",
  "description": "MCP server that drives Google Flow (Veo video / Nano Banana images) through a real browser session, speaking Flow's internal tRPC API first, with a hard credit-cost gate.",
  "type": "module",
  "license": "MIT",
  "author": "Roshan Arnav",
  "homepage": "https://github.com/roshanarnav25-sloth/google-flow-mcp#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/roshanarnav25-sloth/google-flow-mcp.git"
  },
  "bugs": {
    "url": "https://github.com/roshanarnav25-sloth/google-flow-mcp/issues"
  },
  "bin": {
    "google-flow-mcp": "dist/index.js"
  },
  "files": [
    "dist",
    "references",
    "README.md",
    "ARCHITECTURE.md",
    "LICENSE"
  ],
  "scripts": {
    "build": "tsc",
    "dev": "tsc --watch",
    "start": "node dist/index.js",
    "typecheck": "tsc --noEmit",
    "test": "node --import tsx --test test/*.test.ts",
    "lint": "eslint src test",
    "lint:fix": "eslint src test --fix",
    "format": "prettier --write \"**/*.{ts,json,md,yml}\"",
    "format:check": "prettier --check \"**/*.{ts,json,md,yml}\"",
    "inspect": "npx @modelcontextprotocol/inspector --cli node dist/index.js --method tools/list",
    "prepublishOnly": "npm run build"
  },
  "engines": {
    "node": ">=20"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.12.0",
    "playwright-core": "^1.62.0",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "@eslint/js": "^9.15.0",
    "@types/node": "^22.5.0",
    "eslint": "^9.15.0",
    "prettier": "^3.3.3",
    "tsx": "^4.19.0",
    "typescript": "^5.6.2",
    "typescript-eslint": "^8.15.0"
  },
  "keywords": [
    "mcp",
    "model-context-protocol",
    "claude",
    "google-flow",
    "veo",
    "veo-3",
    "video-generation",
    "text-to-video",
    "playwright",
    "browser-automation"
  ]
}
